root = true

# All files
[*]
indent_size = 4
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

# C# files
[*.cs]

# Suppress noisy XML doc warnings (GenerateDocumentationFile requires these)
dotnet_diagnostic.CS1591.severity = none
dotnet_diagnostic.CS1570.severity = none
dotnet_diagnostic.CS1572.severity = none
dotnet_diagnostic.CS1573.severity = none
dotnet_diagnostic.CS1574.severity = none
dotnet_diagnostic.CS1587.severity = none

# IDE0005: Using directive is unnecessary
dotnet_diagnostic.IDE0005.severity = warning

# IDE0007: Use var instead of explicit type (and vice versa)
dotnet_style_prefer_inferred_anonymous_type_member_initializer_names = true:suggestion
dotnet_style_prefer_inferred_tuple_names = true:suggestion
dotnet_style_prefer_auto_properties = true:silent

# IDE0008: Use explicit type instead of var
csharp_style_var_elsewhere = false:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = false:suggestion

# IDE0017: Simplify object initialization
dotnet_diagnostic.IDE0017.severity = suggestion

# IDE0044: Make field readonly
dotnet_diagnostic.IDE0044.severity = suggestion

# IDE0051: Remove unused private members
dotnet_diagnostic.IDE0051.severity = warning

# IDE0052: Remove unread private members
dotnet_diagnostic.IDE0052.severity = suggestion

# IDE0055: Fix formatting
dotnet_diagnostic.IDE0055.severity = warning

# IDE0060: Remove unused parameter
dotnet_diagnostic.IDE0060.severity = warning

# IDE0079: Remove unnecessary suppression
dotnet_diagnostic.IDE0079.severity = warning

# CA1050: Declare types in namespaces
dotnet_diagnostic.CA1050.severity = none

# Meziantou.Analyzer - rules suppressed for this project (with rationale):
# MA0004: Use Task.ConfigureAwait(false) - N/A in ASP.NET Core; there is no SynchronizationContext,
#         so ConfigureAwait(false) is a no-op. Suppressing project-wide is standard ASP.NET Core practice.
dotnet_diagnostic.MA0004.severity = none
# MA0047: Declare type in a namespace - duplicate of CA1050 (suppressed above); the flagged middleware
#         types are referenced by their fully-qualified name and are global by design.
dotnet_diagnostic.MA0047.severity = none
# MA0048: File name must match type name - the project intentionally groups related types
#         (entity + enum + helper records) per file; e.g. FinanceReport.cs holds ~12 related types.
#         This is the established pattern across Models/, so the rule is noise here.
dotnet_diagnostic.MA0048.severity = none
# MA0016: Prefer collection abstraction over implementation - EF Core navigation properties and API
#         models require concrete List<T>/HashSet<T> (EF needs a settable concrete collection).
#         Abstracting them adds no value and can break EF materialization.
dotnet_diagnostic.MA0016.severity = none
# MA0051: Method is too long - the flagged methods are structural and large by nature:
#         hihDataContext.OnModelCreating (535 lines of EF Core config), EdmModelBuilder (305),
#         CommonUtility SQL builders (190-223). Refactoring is large and risky (could subtly change
#         EF model mapping / break tests) and is tracked as deferred follow-up work.
dotnet_diagnostic.MA0051.severity = none
# MA0015: Use ArgumentException overload with the parameter name - the rule requires the paramName to
#         be an actual method parameter, but the codebase validates object STATE (properties) with
#         ArgumentException in many places (e.g. RepeatedDatesWithAmountAndInterestCalInput.doVerify
#         validates TotalAmount/InterestRate/etc. - no matching method param exists; nameof(property)
#         is itself rejected by the rule as "not a valid parameter name"). Satisfying the rule would
#         mean changing exception types to InvalidOperationException across ~35 sites, risking callers
#         and tests for a debuggability-only nicety. Suppressed; high-value rules below remain active.
dotnet_diagnostic.MA0015.severity = none

# CA1869: Avoid creating multiple JSON serializers for same type
dotnet_diagnostic.CA1869.severity = suggestion

# New line preferences
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true

# Indentation
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_indent_labels = one_less_than_current
csharp_indent_block_contents = true
csharp_indent_braces = false
csharp_indent_case_contents_when_block = false

# Qualification preferences
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

# Modifier preferences
dotnet_style_require_accessibility_modifiers = always
csharp_preferred_modifier_order = public,private,protected,static,readonly:suggestion

# Expression preferences
dotnet_diagnostic.IDE0038.severity = suggestion
dotnet_diagnostic.IDE0078.severity = suggestion

# Null checking
dotnet_diagnostic.IDE0029.severity = suggestion
dotnet_diagnostic.IDE0031.severity = suggestion

# Organize usings
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_sections = false
